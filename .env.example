# ── Local development (running outside Docker) ────────────────────────────────
SIM_ENGINE_URL=http://localhost:8001
BACKEND_URL=http://localhost:8080
POSTGRES_DSN=postgresql://metrai:metrai_pass@localhost:5433/metrai

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Must match JWT_SECRET in sim-engine/.env for cross-service token validation
JWT_SECRET=CHANGE_ME_generate_with_secrets_token_hex_32

# ── Docker / EC2 deployment overrides ─────────────────────────────────────────
# These are picked up by docker-compose.yml. Set them in .env on the server.
#
# Mac (Docker Desktop):
# DOCKER_SIM_ENGINE_URL=http://host.docker.internal:8000
# DOCKER_POSTGRES_DSN=postgresql://metrai:metrai_pass@host.docker.internal:5433/metrai
#
# EC2 / Linux (containers share a user-defined network):
# DOCKER_SIM_ENGINE_URL=http://metrai_api:8000
# DOCKER_POSTGRES_DSN=postgresql://metrai:metrai_pass@metrai_postgres:5432/metrai
